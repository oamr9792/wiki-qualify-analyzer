{
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        {
          "//": "wikiapproved.com embeds this app in an iframe. X-Frame-Options: DENY blocked that outright, and it cannot allow specific origins (ALLOW-FROM is unsupported in every modern browser), so frame-ancestors replaces it. Clickjacking protection is retained: only these origins may frame the app.",
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://wikiapproved.com https://www.wikiapproved.com"
        },
        { "key": "Permissions-Policy", "value": "geolocation=(), microphone=(), camera=()" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}